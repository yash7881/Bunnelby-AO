# AO LLM / orchestrator
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash

# Google OAuth Desktop client downloaded from Google Cloud.
# Keep the real JSON out of Git.
GOOGLE_OAUTH_CLIENT_FILE=config/google_oauth_client.json

# AO automatic cloud LLM failover
# Gemini remains primary. Groq is used automatically when Gemini hits quota or is unavailable.
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
# 429 without Retry-After uses this bounded fallback.
GEMINI_COOLDOWN_SECONDS=120
GROQ_COOLDOWN_SECONDS=120
# Part 10.2.2 latency guard: Google SDK timeout is milliseconds internally,
# but this env is seconds. SDK retries are disabled; Model Gateway owns retry/failover.
GEMINI_REQUEST_TIMEOUT_SECONDS=20
# Part 10.2.3 fail-fast default for interactive use: 5xx/transport errors
# immediately try the next provider. Set to 1 only for a non-interactive workload
# where waiting on the same provider is preferable to immediate failover.
# Client-side timeout and 429 are never retried on the same provider.
LLM_MAX_TRANSIENT_RETRIES=0
LLM_TRANSIENT_RETRY_DELAY_MS=250
LLM_TRANSIENT_COOLDOWN_SECONDS=30
# Groq urllib request deadline (seconds).
LLM_REQUEST_TIMEOUT_SECONDS=45

# Part 10 local conversation STT. Keep CPU/int8 until the real-device benchmark
# proves that cuda/int8_float16 is both faster and no less accurate.
STT_ENABLED=true
STT_MODEL=small
STT_DEVICE=cpu
STT_COMPUTE_TYPE=int8
STT_CPU_THREADS=4
STT_BEAM_SIZE=5
# Optional measured decoder context; leave blank unless the same-corpus benchmark wins.
STT_HOTWORDS=
# Used only by the bounded auto-language Hindi rescue inference.
STT_HOTWORDS_HI=कल कैलेंडर चेक करो ईमेल जीमेल आज कल परसों

# Part 10 speech output. Edge is primary; installed Piper voices are the local fallback.
TTS_ENABLED=true
EDGE_TTS_ENABLED=true
TTS_PROVIDER=edge
# The persistent runtime starts this window only after playback actually completes.
FOLLOW_UP_SECONDS=10

# Optional local Piper fallback voice output
PIPER_ENABLED=true
# Leave blank to use %LOCALAPPDATA%\AO\piper\voices
PIPER_VOICE_DIR=
PIPER_ENGLISH_VOICE=en_US-john-medium
PIPER_HINDI_VOICE=hi_IN-rohan-medium
# Initial Phase 6.1 cadence defaults. Tune only after listening to the A/B samples.
PIPER_EN_LENGTH_SCALE=1.11
PIPER_HI_LENGTH_SCALE=1.12

# Phase 6.2 lightweight Web Audio voice character (desktop only)
AO_VOICE_CHARACTER_ENABLED=true
AO_VOICE_CHARACTER_PROFILE=cinematic
# Optional 0.00-0.25 override. Leave blank to use the selected profile default.
AO_VOICE_CHARACTER_AMOUNT=
# Optional language-specific choices. Blank values inherit the global profile/amount.
AO_VOICE_CHARACTER_EN_PROFILE=
AO_VOICE_CHARACTER_HI_PROFILE=
AO_VOICE_CHARACTER_EN_AMOUNT=
AO_VOICE_CHARACTER_HI_AMOUNT=

# Gmail Prompt 7 scopes are defined in code as gmail.readonly + gmail.send.
# After upgrading from the read-only phase, the saved encrypted Gmail token is
# automatically invalidated once if it lacks gmail.send, and Google consent opens again.

# ---------------------------------------------------------------------------
# Part 11.1 - local OCR fallback for scanned PDFs (all optional)
# ---------------------------------------------------------------------------
# OCR requires Tesseract, a separate LOCAL system install. Nothing is sent to
# any cloud service. Native PDF text extraction always runs first; OCR is
# attempted only for pages whose native text is insufficient, and a page that
# cannot be OCR'd stays honestly marked needs_ocr rather than being faked.
#
# Bunnelby discovers tessdata automatically (TESSDATA_PREFIX, then
# `tesseract --list-langs`, then the standard Windows install locations). Set
# BUNNELBY_TESSDATA_DIR only if your install lives somewhere unusual. No PATH
# or TESSDATA_PREFIX change is required.
#
# Install: https://github.com/UB-Mannheim/tesseract/wiki  (choose Hindi and
# Gujarati under "Additional language data"), then verify with
#   & 'C:\Program Files\Tesseract-OCR\tesseract.exe' --list-langs

# Set to 0 to disable OCR entirely; scanned pages then remain metadata-only.
BUNNELBY_OCR_ENABLED=1
# Tesseract language spec. Order matters to Tesseract; eng+hin+guj is default.
BUNNELBY_OCR_LANGUAGES=eng+hin+guj
# Render DPI for OCR. 200 balances accuracy against CPU on a Ryzen 5 laptop;
# clamped to 72-400.
BUNNELBY_OCR_DPI=200
# Absolute path to a tessdata folder. Blank means auto-discover.
BUNNELBY_TESSDATA_DIR=
# A page with fewer than this many alphanumeric native characters is treated as
# image-only and becomes an OCR candidate.
BUNNELBY_OCR_MIN_PAGE_CHARS=12
# Hard caps so one pathological PDF cannot occupy the indexer.
BUNNELBY_OCR_MAX_PAGES=20
BUNNELBY_OCR_DOCUMENT_BUDGET_SECONDS=60
BUNNELBY_OCR_PAGE_TIMEOUT_SECONDS=25
